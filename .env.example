# Copy to .env.local for local development. Never commit real values.

# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-only; never prefix these with NEXT_PUBLIC_)
# Project Settings -> API. Use the service role / secret key: it is only read on the server.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional: email notification for each new project request (via Resend)
# Leave blank to disable notifications.
RESEND_API_KEY=
NOTIFY_EMAIL=mara974a@gmail.com
NOTIFY_FROM=Mara Content Lab <onboarding@resend.dev>

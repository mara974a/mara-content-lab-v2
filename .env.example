# Copy to .env.local for local development. Never commit real values.

# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE: Supabase (Recommended for database storage)
# -----------------------------------------------------------------------------
# Run supabase/migrations/0001_init.sql in your Supabase SQL editor.
# In Cloudflare Pages: Dashboard > Settings > Environment variables
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS: Resend (Recommended for production email delivery)
# -----------------------------------------------------------------------------
# Get a free key at https://resend.com (100 free emails/day)
# In Cloudflare Pages: Dashboard > Settings > Environment variables
RESEND_API_KEY=re_your_api_key_here
NOTIFY_EMAIL=mara974a@gmail.com
NOTIFY_FROM=Mara Content Lab <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# ALTERNATIVE EMAIL: Web3Forms (Optional zero-config form forwarder)
# -----------------------------------------------------------------------------
# Get a free access key at https://web3forms.com
# WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
